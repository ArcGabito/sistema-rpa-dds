FROM node:22-alpine AS deps
WORKDIR /app
COPY core/client/package.json core/client/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY core/client/. .
# Demo credentials shown on /ingresar (empty = not shown). Only read while
# prerendering that page.
ARG DEMO_LOGIN_EMAIL=""
ARG DEMO_LOGIN_PASSWORD=""
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 dds && adduser --system --uid 1001 dds

COPY --from=builder /app/public ./public
COPY --from=builder --chown=dds:dds /app/.next/standalone ./
COPY --from=builder --chown=dds:dds /app/.next/static ./.next/static

USER dds

ENV PORT=3000
EXPOSE 3000

CMD ["node", "server.js"]
